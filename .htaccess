# ═══════════════════════════════════════════════════
# MOONCLIQ — SERVER CLEAN URLS & 301 REDIRECT RULES
# Works natively with Apache / cPanel / LiteSpeed
# ═══════════════════════════════════════════════════

RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Redirect .html URLs to clean URL without .html (301 Permanent Redirect)
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,L,R=301]

# 3. Internally rewrite clean URL to .html file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# 4. Custom Error 404
ErrorDocument 404 /index.html
